# ===== AS Control — configuração do servidor =====
# Copie este arquivo para ".env" e preencha. Nunca envie o .env para o GitHub.

PORT=3000
# Endereço público do sistema (usado nos links das mensagens de alerta)
APP_URL=http://localhost:3000
# Em produção (HTTPS), use production para o cookie de sessão ficar "Secure"
NODE_ENV=development
# Se estiver atrás de proxy/HTTPS do provedor de hospedagem, use true
TRUST_PROXY=
# Pasta onde ficam o banco e os documentos (precisa ser persistente)
DATA_DIR=./storage
# Intervalo das verificações automáticas (vencimentos, atrasos, alertas)
JOB_INTERVAL_MINUTES=15

# ===== Backup automático =====
# Pasta dos backups (um por dia, enquanto o sistema estiver ligado). Padrão: ./backups
# Dica: use uma pasta do OneDrive para ter cópia fora do computador. Ex.: C:\Users\paulo\OneDrive\Backups\as-control
BACKUP_DIR=
# Quantos backups manter (os mais antigos são apagados)
BACKUP_KEEP=30

# ===== WhatsApp (opcional) — sem isto, fica "Pendente de conexão" =====
# Opções: meta | webhook
WHATSAPP_PROVIDER=

# --- Opção 1: API oficial da Meta (WhatsApp Business Cloud API) ---
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_API_VERSION=v21.0
# Nome do template aprovado na Meta (corpo com 6 variáveis: {{1}} a {{6}})
WHATSAPP_META_TEMPLATE=
WHATSAPP_META_TEMPLATE_LANG=pt_BR
# (Opcional) Template separado para prazos e audiências jurídicas (também com 6 variáveis)
WHATSAPP_META_TEMPLATE_JURIDICO=
# Para receber status de entrega (entregue/lido) em /api/webhooks/whatsapp
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_APP_SECRET=

# --- Opção 2: Webhook (n8n, Z-API, Evolution API ou outro provedor) ---
WHATSAPP_WEBHOOK_URL=
# Se preenchido, cada envio leva o cabeçalho X-AS-Control-Signature (HMAC SHA-256)
WHATSAPP_WEBHOOK_SECRET=

# ===== Entrada de cobranças por e-mail/integração (opcional) =====
# Ativa POST /api/webhooks/cobrancas com "Authorization: Bearer <token>"
COBRANCAS_WEBHOOK_TOKEN=
